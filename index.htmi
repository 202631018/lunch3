<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>언주중학교 맞춤 급식 알레르기 안내판</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Google Fonts (Noto Sans KR) -->
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700;800&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Noto Sans KR', sans-serif;
    }
  </style>
</head>
<body class="bg-slate-50 min-h-screen text-slate-800 pb-16">

  <!-- Header -->
  <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm">
    <div class="max-w-3xl mx-auto px-4 py-4 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-full bg-indigo-600 flex items-center justify-center text-white font-bold text-xl shadow-md">
          <i class="fa-solid fa-utensils"></i>
        </div>
        <div>
          <h1 class="font-bold text-lg text-slate-900 leading-tight">언주중학교 급식 알리미</h1>
          <p class="text-xs text-indigo-600 font-medium">안전한 점심 급식 알레르기 케어 System</p>
        </div>
      </div>
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200">
        <i class="fa-solid fa-graduation-cap mr-1"></i> 언주중 전용
      </span>
    </div>
  </header>

  <!-- Main Container -->
  <main class="max-w-3xl mx-auto px-4 pt-6 space-y-6">

    <!-- Hero / Banner -->
    <div class="bg-gradient-to-r from-indigo-600 to-blue-500 rounded-2xl p-6 text-white shadow-lg relative overflow-hidden">
      <div class="relative z-10">
        <span class="bg-white/20 text-white text-xs px-3 py-1 rounded-full font-medium backdrop-blur-md">나이스(NEIS) 실시간 연동</span>
        <h2 class="text-2xl font-extrabold mt-2 mb-1">오늘 점심, 마음 놓고 먹을 수 있을까?</h2>
        <p class="text-indigo-100 text-sm max-w-xl">급식 날짜를 선택하고 알레르기 유발 성분을 지정하세요. 언주중학교 점심 메뉴를 분석하여 안전성을 자동으로 알려드립니다.</p>
      </div>
      <i class="fa-solid fa-shield-halved absolute -right-4 -bottom-6 text-white/10 text-9xl pointer-events-none"></i>
    </div>

    <!-- STEP 1 & 2 Section Card -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6">
      
      <!-- STEP 1: Date Input -->
      <div class="mb-6">
        <label for="meal-date" class="flex items-center text-sm font-bold text-slate-700 mb-2">
          <span class="w-6 h-6 rounded-full bg-indigo-100 text-indigo-600 text-xs flex items-center justify-center mr-2">1</span>
          STEP 1. 날짜 입력 (확인할 급식 날짜 선택)
        </label>
        <div class="relative max-w-xs">
          <input type="date" id="meal-date" class="w-full bg-slate-50 border border-slate-300 text-slate-800 text-sm rounded-xl focus:ring-indigo-500 focus:border-indigo-500 block p-3 pr-10 font-medium shadow-sm transition">
        </div>
      </div>

      <hr class="border-slate-100 my-6">

      <!-- STEP 2: Allergy Selection -->
      <div>
        <div class="flex items-center justify-between mb-3">
          <label class="flex items-center text-sm font-bold text-slate-700">
            <span class="w-6 h-6 rounded-full bg-indigo-100 text-indigo-600 text-xs flex items-center justify-center mr-2">2</span>
            STEP 2. 알레르기 성분 선택 (다중 선택 가능)
          </label>
          <button id="reset-allergy-btn" class="text-xs text-slate-400 hover:text-indigo-600 flex items-center gap-1 transition">
            <i class="fa-solid fa-rotate-right"></i> 초기화
          </button>
        </div>

        <div id="allergy-tags-container" class="flex flex-wrap gap-2">
          <!-- JS에서 알레르기 버튼들이 생성됩니다 -->
        </div>
      </div>

      <!-- Submit / Check Button -->
      <button id="check-btn" class="w-full mt-6 bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-bold py-3.5 px-4 rounded-xl shadow-md transition flex items-center justify-center gap-2 text-base">
        <i class="fa-solid fa-magnifying-glass"></i> 언주중학교 점심 급식 분석하기
      </button>

    </div>

    <!-- Results Section (STEP 3, 4, 5) -->
    <div id="result-section" class="space-y-6">
      
      <!-- Summary Alert Box -->
      <div id="summary-card" class="bg-white rounded-2xl p-5 shadow-sm border border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-4">
          <div id="status-icon" class="w-12 h-12 rounded-2xl bg-indigo-100 text-indigo-600 flex items-center justify-center text-2xl flex-shrink-0">
            <i class="fa-solid fa-utensils"></i>
          </div>
          <div>
            <h3 id="status-title" class="font-bold text-slate-800 text-lg">STEP 5. 결과 제공</h3>
            <p id="status-desc" class="text-xs text-slate-500 mt-0.5">선택한 날짜 및 알레르기 정보에 따른 분석 결과입니다.</p>
          </div>
        </div>
        <div id="status-badges" class="flex gap-2 w-full sm:w-auto justify-end">
          <!-- Status Badges inserted by JS -->
        </div>
      </div>

      <!-- Lunch Card (STEP 3 & 4: 급식 메뉴 확인 & 알레르기 분석) -->
      <div id="lunch-card-container">
        <!-- Lunch Card dynamically inserted by JS -->
      </div>

      <!-- Allergy Info Guide Footer -->
      <div class="bg-indigo-50/50 border border-indigo-100 rounded-xl p-4 text-xs text-indigo-900/80 space-y-1">
        <p class="font-semibold text-indigo-900 flex items-center gap-1.5">
          <i class="fa-solid fa-circle-info"></i> 교육부 지정 18가지 알레르기 유발물질 번호 안내
        </p>
        <p>①난류 ②우유 ③메밀 ④땅콩 ⑤대두 ⑥밀 ⑦게 ⑧새우 ⑨돼지고기 ⑩복숭아 ⑪토마토 ⑫아황산류 ⑬호두 ⑭닭고기 ⑮쇠고기 ⑯오징어 ⑰조개류(굴,전복,홍합) ⑱잣</p>
      </div>

    </div>

  </main>

  <script>
    // 언주중학교 NEIS 교육청 코드 정보
    const NEIS_CONFIG = {
      ATPT_OFCDC_SC_CODE: 'B10', // 서울특별시교육청
      SD_SCHUL_CODE: '7091443'    // 언주중학교 학교코드
    };

    // 18가지 주요 알레르기 성분 목록
    const ALLERGY_LIST = [
      { id: 1, name: "난류(계란)" },
      { id: 2, name: "우유" },
      { id: 3, name: "메밀" },
      { id: 4, name: "땅콩" },
      { id: 5, name: "대두(콩)" },
      { id: 6, name: "밀" },
      { id: 7, name: "게" },
      { id: 8, name: "새우" },
      { id: 9, name: "돼지고기" },
      { id: 10, name: "복숭아" },
      { id: 11, name: "토마토" },
      { id: 12, name: "아황산류" },
      { id: 13, name: "호두" },
      { id: 14, name: "닭고기" },
      { id: 15, name: "쇠고기" },
      { id: 16, name: "오징어" },
      { id: 17, name: "조개류" },
      { id: 18, name: "잣" }
    ];

    // 현재 선택된 알레르기 ID 배열 (기본값: 계란, 우유)
    let selectedAllergies = [1, 2];

    // DOM Elements
    const dateInput = document.getElementById('meal-date');
    const allergyContainer = document.getElementById('allergy-tags-container');
    const checkBtn = document.getElementById('check-btn');
    const resetBtn = document.getElementById('reset-allergy-btn');
    const lunchCardContainer = document.getElementById('lunch-card-container');
    const statusIcon = document.getElementById('status-icon');
    const statusTitle = document.getElementById('status-title');
    const statusDesc = document.getElementById('status-desc');
    const statusBadges = document.getElementById('status-badges');

    // Initialize Application
    function init() {
      // Set today's date (YYYY-MM-DD)
      const today = new Date().toISOString().split('T')[0];
      dateInput.value = today;

      // Render Allergy Toggle Buttons
      renderAllergyButtons();

      // Initial Fetch & Analysis
      fetchAndAnalyze();

      // Event Listeners
      checkBtn.addEventListener('click', fetchAndAnalyze);
      resetBtn.addEventListener('click', () => {
        selectedAllergies = [];
        renderAllergyButtons();
        fetchAndAnalyze();
      });
    }

    // Render Allergy Select Buttons
    function renderAllergyButtons() {
      allergyContainer.innerHTML = '';
      ALLERGY_LIST.forEach(item => {
        const isSelected = selectedAllergies.includes(item.id);
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `px-3 py-1.5 rounded-xl text-xs font-medium border transition duration-150 flex items-center gap-1.5 ${
          isSelected 
            ? 'bg-rose-50 border-rose-300 text-rose-700 font-semibold shadow-sm' 
            : 'bg-slate-50 border-slate-200 text-slate-600 hover:bg-slate-100'
        }`;
        
        btn.innerHTML = `
          <i class="fa-solid ${isSelected ? 'fa-circle-check text-rose-500' : 'fa-plus text-slate-400'}"></i>
          <span>${item.name}</span>
        `;

        btn.addEventListener('click', () => {
          if (selectedAllergies.includes(item.id)) {
            selectedAllergies = selectedAllergies.filter(id => id !== item.id);
          } else {
            selectedAllergies.push(item.id);
          }
          renderAllergyButtons();
        });

        allergyContainer.appendChild(btn);
      });
    }

    // Fetch NEIS Meal Data & Process
    async function fetchAndAnalyze() {
      const selectedDate = dateInput.value.replace(/-/g, ''); // YYYYMMDD 변환

      // Loading UI
      lunchCardContainer.innerHTML = `
        <div class="bg-white rounded-2xl p-12 text-center border border-slate-200 shadow-sm">
          <i class="fa-solid fa-spinner fa-spin text-3xl text-indigo-600 mb-3"></i>
          <p class="text-slate-600 font-medium">언주중학교 나이스 급식 정보를 불러오는 중입니다...</p>
        </div>
      `;

      try {
        // NEIS Open API Call (중식: MMEAL_SC_CODE=2)
        const url = `https://open.neis.go.kr/hub/mealServiceDietInfo?KEY=sample&Type=json&pIndex=1&pSize=100&ATPT_OFCDC_SC_CODE=${NEIS_CONFIG.ATPT_OFCDC_SC_CODE}&SD_SCHUL_CODE=${NEIS_CONFIG.SD_SCHUL_CODE}&MLSV_YMD=${selectedDate}`;
        const response = await fetch(url);
        const data = await response.json();

        if (data.mealServiceDietInfo && data.mealServiceDietInfo[1].row) {
          // 중식(MMEAL_SC_CODE === '2') 추출
          const lunchData = data.mealServiceDietInfo[1].row.find(row => row.MMEAL_SC_CODE === '2');

          if (lunchData) {
            const parsedMenuItems = parseDishString(lunchData.DDISH_NM);
            renderLunchCard(parsedMenuItems, lunchData.CAL_INFO);
          } else {
            renderNoMealCard("해당 날짜에 제공되는 점심 급식이 없습니다 (주말/공휴일/방학 등).");
          }
        } else {
          renderNoMealCard("해당 날짜의 언주중학교 급식 정보가 존재하지 않습니다.");
        }
      } catch (error) {
        console.error("NEIS API Fetch Error:", error);
        renderNoMealCard("나이스 서버에서 급식 데이터를 가져오지 못했습니다.");
      }
    }

    // Parse NEIS dish string into dish names and allergy IDs
    function parseDishString(dishStr) {
      if (!dishStr) return [];
      
      const lines = dishStr.split('<br/>');
      return lines.map(line => {
        const cleanLine = line.replace(/<[^>]*>?/gm, '').trim();
        const allergyMatch = cleanLine.match(/\(([\d\.]+)\)/);
        let allergies = [];
        
        if (allergyMatch && allergyMatch[1]) {
          allergies = allergyMatch[1].split('.')
            .map(num => parseInt(num, 10))
            .filter(num => !isNaN(num));
        }

        const name = cleanLine.replace(/\([\d\.]+\)/g, '').trim();

        return { name, allergies };
      }).filter(item => item.name.length > 0);
    }

    // Render Lunch Results
    function renderLunchCard(menuItems, calInfo) {
      let totalDangerCount = 0;
      let menuListHTML = '';

      menuItems.forEach(item => {
        // STEP 4: 알레르기 성분 분석
        const matched = item.allergies.filter(id => selectedAllergies.includes(id));
        const isDanger = matched.length > 0;

        if (isDanger) totalDangerCount++;

        const allergyNames = item.allergies.map(id => {
          const found = ALLERGY_LIST.find(a => a.id === id);
          return found ? found.name : id;
        }).join(', ');

        const dangerNames = matched.map(id => ALLERGY_LIST.find(a => a.id === id)?.name).join(', ');

        menuListHTML += `
          <li class="py-3 px-3.5 rounded-xl transition ${isDanger ? 'bg-rose-50/90 border border-rose-200' : 'hover:bg-slate-50 border border-transparent'}">
            <div class="flex items-center justify-between">
              <span class="font-bold text-base ${isDanger ? 'text-rose-900' : 'text-slate-800'}">
                ${item.name}
              </span>
              ${isDanger ? `
                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-rose-100 text-rose-700">
                  <i class="fa-solid fa-triangle-exclamation mr-1"></i> 섭취 금지/주의
                </span>
              ` : `
                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-50 text-emerald-600">
                  <i class="fa-solid fa-check mr-1"></i> 안전
                </span>
              `}
            </div>
            
            <div class="mt-1 flex items-center justify-between text-xs">
              <span class="text-slate-400">
                포함 성분: ${allergyNames || '없음'}
              </span>
              ${isDanger ? `
                <span class="font-semibold text-rose-600">
                  위험 요인: ${dangerNames}
                </span>
              ` : ''}
            </div>
          </li>
        `;
      });

      // Lunch Card Insertion (STEP 3 & 4)
      lunchCardContainer.innerHTML = `
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
          <div class="p-5 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
            <div class="flex items-center space-x-3">
              <div class="w-9 h-9 rounded-xl bg-indigo-100 text-indigo-600 flex items-center justify-center font-bold">
                <i class="fa-solid fa-utensils"></i>
              </div>
              <div>
                <h3 class="font-bold text-slate-800 text-base">STEP 3. 오늘의 점심 식단 (중식)</h3>
                <p class="text-xs text-slate-400">${calInfo || ''}</p>
              </div>
            </div>
            <span class="text-xs font-bold px-3 py-1 rounded-full ${
              totalDangerCount > 0 
                ? 'bg-rose-100 text-rose-700' 
                : 'bg-emerald-100 text-emerald-700'
            }">
              ${totalDangerCount > 0 ? `주의 필요 ${totalDangerCount}개` : '모든 식단 안전'}
            </span>
          </div>

          <ul class="p-5 space-y-2">
            ${menuListHTML}
          </ul>

          <div class="p-4 bg-slate-50 border-t border-slate-100 text-center">
            <span class="text-xs font-medium text-slate-600">
              ${totalDangerCount > 0 ? '⚠️ 붉은색 카드로 표시된 식단은 알레르기 유발 물질이 들어있어 섭취를 피해야 합니다.' : '✅ 선택하신 알레르기 유발 성분이 포함된 메뉴가 없습니다.'}
            </span>
          </div>
        </div>
      `;

      // Update Summary Header (STEP 5)
      if (selectedAllergies.length === 0) {
        statusIcon.className = 'w-12 h-12 rounded-2xl bg-slate-100 text-slate-500 flex items-center justify-center text-2xl flex-shrink-0';
        statusIcon.innerHTML = '<i class="fa-solid fa-info"></i>';
        statusTitle.textContent = '선택된 알레르기 항목이 없습니다';
        statusDesc.textContent = '상단에서 본인의 알레르기 유발 성분을 선택해 주세요.';
        statusBadges.innerHTML = '';
      } else if (totalDangerCount > 0) {
        statusIcon.className = 'w-12 h-12 rounded-2xl bg-rose-100 text-rose-600 flex items-center justify-center text-2xl flex-shrink-0';
        statusIcon.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i>';
        statusTitle.textContent = `오늘 점심 중 피해야 할 메뉴가 ${totalDangerCount}개 있습니다!`;
        statusDesc.textContent = '선택한 알레르기 성분이 들어간 메뉴는 경고 표시가 뜹니다.';
        statusBadges.innerHTML = `
          <span class="px-3 py-1 bg-rose-100 text-rose-700 font-bold text-xs rounded-lg flex items-center gap-1">
            <i class="fa-solid fa-triangle-exclamation"></i> 위험 메뉴 ${totalDangerCount}개
          </span>
        `;
      } else {
        statusIcon.className = 'w-12 h-12 rounded-2xl bg-emerald-100 text-emerald-600 flex items-center justify-center text-2xl flex-shrink-0';
        statusIcon.innerHTML = '<i class="fa-solid fa-circle-check"></i>';
        statusTitle.textContent = '오늘 점심은 마음 놓고 먹어도 좋습니다!';
        statusDesc.textContent = '선택한 알레르기 유발 성분이 포함된 메뉴가 없습니다.';
        statusBadges.innerHTML = `
          <span class="px-3 py-1 bg-emerald-100 text-emerald-700 font-bold text-xs rounded-lg flex items-center gap-1">
            <i class="fa-solid fa-shield-halved"></i> 모두 안전
          </span>
        `;
      }
    }

    // Render Case when Meal Data is Missing
    function renderNoMealCard(message) {
      lunchCardContainer.innerHTML = `
        <div class="bg-white rounded-2xl p-10 text-center border border-slate-200 shadow-sm space-y-2">
          <div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mx-auto text-xl">
            <i class="fa-solid fa-calendar-xmark"></i>
          </div>
          <p class="text-slate-700 font-bold text-base">${message}</p>
          <p class="text-xs text-slate-400">다른 날짜를 선택하여 다시 확인해 보세요.</p>
        </div>
      `;

      statusIcon.className = 'w-12 h-12 rounded-2xl bg-slate-100 text-slate-400 flex items-center justify-center text-2xl flex-shrink-0';
      statusIcon.innerHTML = '<i class="fa-solid fa-slash"></i>';
      statusTitle.textContent = '급식 데이터 없음';
      statusDesc.textContent = message;
      statusBadges.innerHTML = '';
    }

    // Run App
    init();
  </script>
</body>
</html>
